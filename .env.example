# Copia este archivo como ".env" para desarrollo local.
# En Vercel, estas mismas variables se ponen en Project › Settings › Environment Variables.

# Base de datos MongoDB Atlas (igual que en el resto de webs). Sin ella, en local
# se usa automáticamente una base de datos de prueba guardada en data/.
MONGODB_URI=
MONGODB_DB=elcatavinos

# Primer usuario del panel /admin (opcional: si no se pone, /admin pide crearlo la primera vez)
ADMIN_EMAIL=admin@elcatavinos.net
ADMIN_PASSWORD=cambia-esta-contraseña

# Dirección pública de la web (para enlaces en emails y pagos). Opcional.
BASE_URL=

# Fotos subidas desde el panel: Vercel Blob (Vercel la añade sola al conectar un Blob store)
BLOB_READ_WRITE_TOKEN=

# Pagos con tarjeta (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Envío de emails (ej. Gmail con "contraseña de aplicación")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="El Catavinos <elcatavinos2015@gmail.com>"

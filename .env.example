# Copia este archivo como ".env" y rellena los valores.

# Puerto y dirección pública de la web (para enlaces en emails y pagos)
PORT=3000
BASE_URL=https://elcatavinos.net

# Primer usuario del panel /admin (solo se usa la primera vez que arranca)
ADMIN_EMAIL=elcatavinos2015@gmail.com
ADMIN_PASSWORD=cambia-esta-contraseña

# Carpeta donde se guardan la base de datos y las fotos subidas (hacer copias de seguridad)
# DATA_DIR=/var/data/catavinos

# Pagos con tarjeta (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Envío de emails (ej. Gmail con "contraseña de aplicación", o tu proveedor de correo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="El Catavinos <elcatavinos2015@gmail.com>"

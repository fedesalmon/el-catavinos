<%- include('_head', { title: 'Categorías' }) %>
<div class="ahead"><h1>Categorías de la tienda</h1></div>
<div class="acards">
  <% categories.forEach(c => { %>
  <form method="post" action="/admin/categorias/<%= c.id %>" class="acard">
    <div class="agrid-f agrid-f--3">
      <label class="af">Nombre<input name="name" value="<%= c.name %>" required></label>
      <label class="af">Orden<input name="sort" type="number" value="<%= c.sort %>"></label>
      <div class="af"><span>Productos</span><a href="/admin/productos?cat=<%= c.id %>" class="strong"><%= c.n %> productos →</a></div>
    </div>
    <label class="af">Descripción <small>Se muestra en la página de la categoría</small><textarea name="description" rows="2"><%= c.description %></textarea></label>
    <div class="row-actions"><button class="abtn abtn--wine abtn--sm">Guardar</button><a class="small" href="/tienda/categoria/<%= c.slug %>" target="_blank">Ver ↗</a>
      <button name="delete" value="1" class="abtn abtn--danger abtn--sm" data-confirm="¿Eliminar la categoría «<%= c.name %>»? Los productos no se borran.">Eliminar</button></div>
  </form>
  <% }) %>
  <form method="post" action="/admin/categorias" class="acard acard--new">
    <h2>Nueva categoría</h2>
    <div class="agrid-f agrid-f--3"><label class="af">Nombre<input name="name" required></label><label class="af">Orden<input name="sort" type="number" value="99"></label></div>
    <label class="af">Descripción<textarea name="description" rows="2"></textarea></label>
    <button class="abtn abtn--wine abtn--sm">Crear categoría</button>
  </form>
</div>
<%- include('_foot') %>

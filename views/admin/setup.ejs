<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
<title>Crear cuenta · <%= s.business_name %></title><link rel="icon" href="/img/favicon-32.png">
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Playfair+Display:wght@600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css?v=1"></head>
<body class="login">
  <form method="post" action="/admin/setup" class="acard login__card">
    <img src="/img/site/logo.webp" alt="<%= s.business_name %>" width="160" height="89">
    <h1>Bienvenido</h1>
    <p class="small muted">Es la primera vez que se abre el panel. Crea tu cuenta de administrador para gestionar la web.</p>
    <% if (error) { %><div class="aerr"><%= error %></div><% } %>
    <label class="af">Tu nombre<input name="name" value="<%= form.name || '' %>" autocomplete="name"></label>
    <label class="af">Email<input type="email" name="email" required value="<%= form.email || '' %>" autocomplete="username"></label>
    <label class="af">Contraseña <small>Mínimo 8 caracteres</small><input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
    <label class="af">Repite la contraseña<input type="password" name="password2" required minlength="8" autocomplete="new-password"></label>
    <button class="abtn abtn--wine abtn--block">Crear cuenta y entrar</button>
  </form>
</body></html>
